# MongoDB Atlas 연결 문자열 (예: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/nova)
MONGODB_URI=mongodb://localhost:27017/nova-judging

# JWT 서명 비밀키 (HS256). 운영 환경에서는 32바이트 이상 랜덤 문자열로 교체
JWT_SECRET=change-me-to-a-long-random-string

# JWT TTL (default 12h)
JWT_TTL=12h

# CORS 허용 origin (콤마 구분). Vercel preview + production 도메인 등록
CORS_ORIGINS=http://localhost:5173,https://evaluation-front.vercel.app

# Express 포트
PORT=3000

# 실행 모드
NODE_ENV=development

# bcrypt cost factor
BCRYPT_ROUNDS=10

# Login rate limit (per IP+name)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# 시드 md 원천 경로 (npm run seed)
SEED_MD_PATH=./seed-data/팀별_스킬_정리.md
